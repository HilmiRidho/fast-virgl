+/* Reusable scratch buffer: avoids a malloc()/free() (and, for big texture
+ * transfers, an mmap/munmap + page-fault storm) on every submit/transfer.
+ * The vtest server handles one command at a time per process, and the
+ * buffer is only used synchronously within a single command. */
+#define VTEST_SCRATCH_KEEP_MAX (32u * 1024u * 1024u)
+static void *vtest_scratch;
+static size_t vtest_scratch_size;
+
+static void *vtest_scratch_get(size_t size)
+{
+   void *p;
+
+   if (size > VTEST_SCRATCH_KEEP_MAX)
+      return malloc(size);
+
+   if (size > vtest_scratch_size) {
+      size_t new_size = size < 65536 ? 65536 : size;
+      p = realloc(vtest_scratch, new_size);
+      if (!p)
+         return NULL;
+      vtest_scratch = p;
+      vtest_scratch_size = new_size;
+   }
+   return vtest_scratch;
+}
+
+/* must be called with the same size that was passed to vtest_scratch_get() */
+static void vtest_scratch_put(void *p, size_t size)
+{
+   if (p && size > VTEST_SCRATCH_KEEP_MAX)
+      free(p);
+}
