+/* glGetError() after every decoded command / transfer forces a CPU<->GPU
+ * round trip on many Android GLES drivers (Mali/Adreno) and is the main
+ * per-command overhead of the vtest path.  After renderer init it is skipped
+ * by default; set VIRGL_GL_ERROR_CHECK=1 to get the old behaviour back. */
+static bool vrend_skip_gl_error_check = false;
+
+static void vrend_init_gl_error_check_policy(void)
+{
+   const char *e = getenv("VIRGL_GL_ERROR_CHECK");
+   vrend_skip_gl_error_check = !(e && e[0] && e[0] != '0');
+}
+
 bool vrend_check_no_error(struct vrend_context *ctx)
 {
    GLenum err;
 
+   if (vrend_skip_gl_error_check)
+      return true;
+
    err = glGetError();
    if (err == GL_NO_ERROR)
       return true;
@@ -7752,6 +7767,8 @@
       goto cleanup_and_fail;
    }
 
+   vrend_init_gl_error_check_policy();
